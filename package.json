{
  "name": "@get-air/stremio-addon-client",
  "version": "0.1.0",
  "packageManager": "pnpm@11.16.0",
  "description": "Safe Promise and Effect client for consuming Stremio addons",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./effect": {
      "types": "./dist/effect.d.ts",
      "import": "./dist/effect.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "effect-language-service diagnostics --project tsconfig.json --strict --format text && tsc -p tsconfig.json --noEmit",
    "ci": "pnpm check && pnpm test && pnpm build && env -u npm_config_manage_package_manager_versions npm pack --dry-run --ignore-scripts",
    "ci:act": "act push --job ci",
    "prepack": "pnpm build",
    "test": "vitest run"
  },
  "dependencies": {
    "@get-air/cache": "^0.1.0",
    "@get-air/http": "^0.1.0",
    "effect": "^3.22.1"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.2",
    "@effect/vitest": "^0.30.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": { "node": ">=20.19" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/get-air/stremio-addon-client.git"
  },
  "bugs": { "url": "https://github.com/get-air/stremio-addon-client/issues" },
  "homepage": "https://github.com/get-air/stremio-addon-client#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": ["stremio", "addon", "client", "effect", "typescript"]
}
